# Copie para as "Environment Variables" do Render. NUNCA suba o .env real para o GitHub.

# Discord Developer Portal -> PATO BLOX FRUITS -> Bot -> Reset Token
DISCORD_TOKEN=

# Já preenchidos para o seu servidor
DISCORD_GUILD_ID=1495633332887883936

# Opcionais (botão direito no canal/usuário -> Copiar ID)
DISCORD_OWNER_ID=
DISCORD_DELIVERED_CHANNEL_ID=
DISCORD_REVIEWS_CHANNEL_ID=
DISCORD_LOG_CHANNEL_ID=

# Neon (Connection Details -> formato JDBC)
DB_URL=jdbc:postgresql://SEU-HOST.neon.tech/neondb?sslmode=require
DB_USER=
DB_PASSWORD=

# AmploPay -> Integrações -> API -> Nova credencial (Criar/Consultar transações)
AMPLOPAY_PUBLIC_KEY=
AMPLOPAY_SECRET_KEY=

# URL do serviço no Render + /webhooks/amplopay
AMPLOPAY_CALLBACK_URL=https://pato-bot.onrender.com/webhooks/amplopay

ORDER_EXPIRATION_MINUTES=30
